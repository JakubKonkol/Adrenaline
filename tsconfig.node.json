{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/node.tsbuildinfo",
    "types": ["node"],
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "native/engine/tests/**/*.ts"
  ]
}
