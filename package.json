{
  "name": "adrenaline",
  "productName": "Adrenaline",
  "version": "1.0.0",
  "description": "Find a movie or an episode, pick a release and a subtitle language, download it and open a ready folder.",
  "private": true,
  "main": "out/main/index.js",
  "author": "Jakub Konkol",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:tv": "vite build -c vite.tv.config.ts",
    "dev:tv": "vite -c vite.tv.config.ts",
    "tv:prepare": "npm run build:tv && node scripts/tv/prepare-tizen.mjs && node scripts/tv/prepare-android.mjs",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test -c playwright.config.ts",
    "test:engine": "vitest run -c native/engine/tests/vitest.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "pack:win": "npm run build && electron-builder --win --x64 --publish never",
    "crash-loop": "vitest run -c scripts/dev/vitest.crash-loop.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.104.3",
    "electron-updater": "6.8.9",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "lucide-react": "1.57.0",
    "node-forge": "1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xmldom/xmldom": "0.8.15",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "extract-zip": "2.0.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "xml-crypto": "6.4.0"
  }
}
